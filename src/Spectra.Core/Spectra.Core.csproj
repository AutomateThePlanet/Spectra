<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Spectra.Core</PackageId>
    <Authors>Anton Angelov</Authors>
    <Company>Automate The Planet</Company>
    <Description>Core library for SPECTRA — AI-native test generation framework. Shared models, parsing, validation, and coverage analysis.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AutomateThePlanet/Spectra</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AutomateThePlanet/Spectra</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>testing;test-generation;ai;mcp;qa;test-automation;spectra</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Spec 099 F6: new warnings fail the build (all configurations). NuGet vulnerability advisories stay warnings:
         one published after the fact must not break a build that changed nothing. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.14" />
    <PackageReference Include="YamlDotNet" Version="17.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Spec 040: legacy DocumentIndexReader is internal and used only by
         LegacyIndexMigrator (one-time legacy → v2 migration). -->
    <InternalsVisibleTo Include="Spectra.CLI" />
    <InternalsVisibleTo Include="Spectra.Core.Tests" />
    <!-- Spec 099: ParseCounter, TestCase.LayoutOmitted and internal SectionExtractor overloads in CLI tests. -->
    <InternalsVisibleTo Include="Spectra.CLI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
